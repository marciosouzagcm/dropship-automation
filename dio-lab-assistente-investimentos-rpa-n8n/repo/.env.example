# Opcional: fixe uma versão do n8n em vez de usar a imagem mais recente.
N8N_VERSION=latest
N8N_PORT=5678
TZ=America/Sao_Paulo

# URL usada pelo RPA dentro da rede Docker; os arquivos são servidos pelo serviço docs.
URL_PAGINA=http://docs/

# O padrão abaixo funciona com o workflow ativado (Production URL).
# Para testar, use http://n8n:5678/webhook-test/clientes enquanto o webhook estiver ouvindo.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/clientes