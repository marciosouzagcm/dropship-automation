# =============================================================================
# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA versionar o ".env" real no Git (já está no .gitignore).
# =============================================================================

# --- n8n ---
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_USER=admin
N8N_PASSWORD=troque_esta_senha_antes_de_subir_o_projeto
TIMEZONE=America/Sao_Paulo

# --- Redis ---
# CORREÇÃO (auditoria v2.1): o Redis não tinha senha e ficava exposto na
# porta do host. Preencha com um valor forte — é usado tanto pelo n8n
# (fila de execuções) quanto pelo worker (media-processor).
REDIS_PASSWORD=troque_por_uma_senha_forte

# --- APIs de IA Generativa (scripts/hooks) ---
GEMINI_API_KEY=coloque_sua_chave_aqui
ANTHROPIC_API_KEY=coloque_sua_chave_aqui

# --- TTS (narração sintética) e Whisper (legendagem) ---
TTS_PROVIDER=elevenlabs            # elevenlabs | openai
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
OPENAI_API_KEY=
WHISPER_MODEL_SIZE=base            # tiny | base | small | medium | large (cuidado com custo de CPU)

# --- Telegram ---
TELEGRAM_BOT_TOKEN=coloque_seu_token_aqui
TELEGRAM_CHAT_ID=coloque_seu_chat_id_aqui          # chat privado do operador (aprovação)
TELEGRAM_CHANNEL_ID=coloque_o_id_do_canal_aqui      # canal público de vendas (distribuição final)

# --- APIs de Afiliados (Sub-Agente 1 / worker/services/affiliate.py) ---
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_APP_KEY=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
# Necessário apenas na primeira execução do workflow "Cron - Refresh Token
# Mercado Livre": gere este token seguindo o fluxo OAuth do Mercado Livre
# Developers uma única vez. Depois disso, o próprio workflow renova e
# armazena o token atualizado no Redis (chave ml_auth_tokens) — este valor
# de .env deixa de ser lido.
MERCADO_LIVRE_REFRESH_TOKEN=

# --- Distribuição multicanal (worker/services/distribution.py) ---
INSTAGRAM_GRAPH_API_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
TIKTOK_CONTENT_POSTING_TOKEN=

# --- Exposição pública do n8n (necessária para webhooks do Telegram/Instagram/TikTok) ---
N8N_WEBHOOK_URL=https://SEU_DOMINIO_PUBLICO
# Caminho do webhook do Sub-Agente 2 que recebe o conteúdo pronto do worker.
# Só troque se você também renomear o path do node "Webhook: Conteúdo Pronto
# (do Worker)" no workflow sub-agente-2-aprovacao-telegram.json.
N8N_WEBHOOK_APROVACAO_PATH=/webhook/conteudo-pronto-aprovacao
CLOUDFLARE_TUNNEL_TOKEN=coloque_o_token_do_tunel_aqui

# --- Segurança dos webhooks internos (novo em v2.1) ---
# CORREÇÃO (auditoria v2.1): os webhooks novo-produto-minerado e
# conteudo-pronto-aprovacao estavam abertos, sem nenhuma autenticação —
# qualquer requisição HTTP conseguia disparar chamadas pagas de API e
# encher as filas do Redis. Agora ambos exigem o header
# "x-webhook-secret" com este valor. Gere uma string aleatória forte
# (ex.: openssl rand -hex 32) e use o MESMO valor aqui, no
# minerador_main.py (via env) e em worker/worker.py (já lê daqui).
WEBHOOK_SHARED_SECRET=troque_por_uma_string_aleatoria_longa

# Token secreto do webhook do Telegram (mecanismo nativo do Bot API, não é
# um valor que você inventa livremente aqui e sim o mesmo que você passar
# para o parâmetro secret_token do scripts/bash/setup-telegram-webhook.sh).
# O Telegram devolve esse valor no header X-Telegram-Bot-Api-Secret-Token
# em toda chamada de callback, permitindo ao Sub-Agente 3 validar que a
# requisição realmente veio do Telegram.
TELEGRAM_WEBHOOK_SECRET_TOKEN=troque_por_outra_string_aleatoria_longa

# --- Publicação pública de mídia (Instagram Graph API / TikTok) ---
# URL pública onde assets/processed é servido. Se estiver usando o serviço
# `assets-server` (Nginx) incluído no docker-compose.yml, exponha-o via
# Cloudflare Tunnel (rota separada) ou proxy reverso e cole a URL aqui.
# Deixe em branco para desativar a publicação em Instagram/TikTok sem
# quebrar o restante do pipeline (Telegram continua funcionando normalmente).
PUBLIC_ASSETS_BASE_URL=
